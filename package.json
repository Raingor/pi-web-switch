{
  "name": "@raingor/pi-web-switch",
  "private": false,
  "version": "0.4.1",
  "type": "module",
  "main": "dist-electron/main/main.cjs",
  "description": "Web UI for pi coding agent — live configuration management, session browser, and memory viewer",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "dashboard",
    "configuration",
    "web-ui"
  ],
  "author": "Raingor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raingor/pi-web-switch.git"
  },
  "bugs": {
    "url": "https://github.com/Raingor/pi-web-switch/issues"
  },
  "homepage": "https://github.com/Raingor/pi-web-switch#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "tsc -b && vite build && vite build --config vite.electron.config.ts && vite build --config vite.preload.config.ts && electron-builder",
    "electron:preview": "vite build && vite build --config vite.electron.config.ts && vite build --config vite.preload.config.ts && env -u ELECTRON_RUN_AS_NODE npx electron .",
    "tray:icon": "node scripts/generate-tray-icon.mjs"
  },
  "files": [
    "pi-package",
    "server",
    "src",
    "public",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md"
  ],
  "pi": {
    "extensions": [
      "./pi-package/index.ts"
    ],
    "skills": [
      "./pi-package/skills"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "lucide-react": "^0.487.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.3",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "undici": "^8.9.0",
    "vite": "^6.3.2",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.raingor.pi-web-switch",
    "productName": "pi-web-switch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        { "target": "dmg" },
        { "target": "zip" }
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true,
        "LSMinimumSystemVersion": "11.0.0",
        "CFBundleName": "pi-web-switch"
      },
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
